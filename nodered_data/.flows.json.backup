        "name": "ABC",
        "func": "let MACHINE_IDS = [];\nfor (let i = 1; i <= 1000; i++) {\n    MACHINE_IDS.push(`ABC-${String(i).padStart(4, \"0\")}`);\n}\n// Função sinusoidal com randomização\nfunction sinusoidal(base, amplitude, period) {\n    const t = Date.now() % period; // tempo relativo, sem estado\n    return base + amplitude * Math.sin(t / period);\n}\n\n// Gera um objeto por máquina\nfunction generateMachine(id) {\n\n    // Cada parâmetro recebe um período aleatório entre 3s e 30s\n    const randPeriod = () => Math.floor(Math.random() * (30000 - 3000)) + 3000;\n\n    return {\n        machineId: id,\n        timestamp: Date.now(),\n\n        temperature: sinusoidal(60, 20, randPeriod()),\n        vibration: sinusoidal(2, 1.5, randPeriod()),\n        loadPercentage: sinusoidal(50, 40, randPeriod()),\n        rpm: sinusoidal(2000, 800, randPeriod()),\n        voltage: sinusoidal(230, 10, randPeriod()),\n        current: sinusoidal(10, 8, randPeriod()),\n        pressure: sinusoidal(6, 4, randPeriod()),\n        humidity: sinusoidal(40, 30, randPeriod()),\n        oilLevel: sinusoidal(70, 20, randPeriod()),\n        coolantTemperature: sinusoidal(55, 15, randPeriod()),\n\n        cycleCount: Math.floor(Math.random() * 200000),\n        powerConsumption: sinusoidal(3, 1.5, randPeriod()),\n        torque: sinusoidal(100, 40, randPeriod()),\n        bearingWear: Math.random() * 20,\n        noiseLevel: sinusoidal(60, 10, randPeriod()),\n\n        errorCode: Math.random() < 0.02 ? 1 : 0,\n        networkLatency: sinusoidal(10, 5, randPeriod()),\n        uptimeHours: Math.random() * 5000,\n\n        status: \"OK\"\n    };\n}\n\n// Ajusta status\nfunction adjustStatus(obj) {\n    if (obj.errorCode === 1) obj.status = \"ERROR\";\n    else if (obj.vibration > 4 || obj.temperature > 85) obj.status = \"WARNING\";\n    return obj;\n}\n\n// Gera todas as máquinas\nmsg.payload = MACHINE_IDS.map(id => adjustStatus(generateMachine(id)));\n\nreturn msg;\n",
