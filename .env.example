# Set this to a long, random, stable value before starting n8n.
N8N_ENCRYPTION_KEY=replace-with-a-long-random-secret

# n8n public address. Update these when exposing n8n behind a domain/reverse proxy.
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678
WEBHOOK_URL=http://localhost:5678/

# Use an IANA timezone, for example Europe/Lisbon.
GENERIC_TIMEZONE=UTC
OLLAMA_PORT=11434